# Required: tags you pushed from scripts/docker-release-build.sh (or your registry).
NEURON_IMAGE=registry.example.com/iot/neuron-full:latest
REMOTE_STUB_IMAGE=registry.example.com/iot/neuron-remote-stub:latest

NEURON_HTTP_PORT=7000
REMOTE_STUB_HTTP_PORT=18080
TZ=UTC
NEURON_LOG_LEVEL=info

# JWT / API token Neuron accepts for HTTP API calls from the stub (set after you create one in the UI or API).
REMOTE_NEURON_TOKEN=

# Set to 1 only for lab / self-signed upstreams when using TLS from the stub.
REMOTE_TLS_INSECURE=0
